    "build:arena": "esbuild static/js/arena.js --bundle --format=esm --target=es2020 --outdir=static/js --entry-names=arena.bundle",
    "test:browser": "playwright test",
    "build:workspace": "esbuild static/js/multi-file-workspace.js --bundle --format=esm --target=es2020 --outdir=static/js --entry-names=multi-file-workspace.bundle"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
