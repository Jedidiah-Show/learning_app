# Copy to .env for local development. Never commit real credentials.
# Values below are fake placeholders, not working secrets.

# --- Core ---------------------------------------------------------------
APP_ENV=development
# Legacy alias; prefer APP_ENV.
FLASK_ENV=
FLASK_DEBUG=1
SECRET_KEY=<GENERATE_WITH_python_-c_import_secrets_print_secrets.token_urlsafe(32)>
TOKEN_ENCRYPTION_KEY=<GENERATE_A_SECOND_STABLE_RANDOM_VALUE>
PREFERRED_URL_SCHEME=http
PUBLIC_APP_URL=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080
ADMIN_API_TOKEN=<SET_IN_RENDER_DASHBOARD>
LESSON_EXTRAS_TOKEN=<SET_IN_RENDER_DASHBOARD>

# --- Database -----------------------------------------------------------
# Use SQLite locally, or a development Postgres/Neon database.
DATABASE_URL=sqlite:///../data/learning_app.db
# Direct Neon URL used only by `flask db upgrade` (not by the running app).
DATABASE_URL_UNPOOLED=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=ruach-learning-app

# --- AI: Gemini + OpenRouter fallback ----------------------------------
GEMINI_API_KEY=<SET_IN_RENDER_DASHBOARD>
GOOGLE_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_REQUESTS_PER_MINUTE=30
GEMINI_REQUESTS_PER_DAY=300
GEMINI_MAX_ATTEMPTS=3
GEMINI_CONNECT_TIMEOUT=5
GEMINI_READ_TIMEOUT=120
AI_REQUEST_DEADLINE_SECONDS=50
AI_PROVIDER_COOLDOWN_SECONDS=30
AI_RATE_LIMIT_COOLDOWN_SECONDS=60
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FLASH_MODEL=openrouter/auto
OPENROUTER_PRO_MODEL=openrouter/auto
OPENROUTER_APP_NAME=RUACH AI Engineering
OPENROUTER_SITE_URL=http://127.0.0.1:8080
OPENROUTER_JSON_MODE=1
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_CONNECT_TIMEOUT=5
OPENROUTER_READ_TIMEOUT=120

# --- Google OAuth, Gmail, and Twilio -----------------------------------
GOOGLE_CLIENT_ID=<SET_IN_RENDER_DASHBOARD>
GOOGLE_CLIENT_SECRET=<SET_IN_RENDER_DASHBOARD>
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/calendar/oauth2callback
GMAIL_SENDER_EMAIL=<SET_IN_RENDER_DASHBOARD>
GMAIL_REFRESH_TOKEN=<SET_IN_RENDER_DASHBOARD>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Managed internally by the Calendar OAuth flow; normally leave unset.
OAUTHLIB_RELAX_TOKEN_SCOPE=

# --- File storage -------------------------------------------------------
# local = development only. s3 = Cloudflare R2 or another S3-compatible store.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=ruach-learning-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=<SET_IN_RENDER_DASHBOARD>
S3_SECRET_ACCESS_KEY=<SET_IN_RENDER_DASHBOARD>
S3_PUBLIC_BASE_URL=https://files.example.com

# --- Dev-only scripts ---------------------------------------------------
YOUTUBE_API_KEY=
LESSON_EXTRAS_ENDPOINT=https://text.pollinations.ai/openai
LESSON_EXTRAS_MODEL=openai
LESSON_EXTRAS_BASE=https://learning-app.onrender.com
